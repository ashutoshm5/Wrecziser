{
  "manifest_version": 3,
  "name": "Wreciser",
  "version": "1.0.0",
  "description": "Summarise any page locally and send it to Notepad or Wrecz.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "downloads.open",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "*://*.linkedin.com/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wreciser",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
